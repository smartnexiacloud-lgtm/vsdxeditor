{
  "name": "vsdxeditor",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --outfile=dist/main.js --format=iife --minify",
    "postbuild": "cp src/index.html dist/index.html",
    "dev": "esbuild src/main.js --bundle --outfile=dist/main.js --format=iife --servedir=dist --serve=8080",
    "test:oreilly-fixtures": "node scripts/test-oreilly-fixtures.mjs",
    "test:render-regressions": "node scripts/test-render-regressions.mjs",
    "test:libvisio-port": "node --test tests/libvisio-ng-port.test.mjs",
    "export:our-svg": "node scripts/export-our-svg.mjs",
    "compare:renderers": "node scripts/compare-renderers.mjs",
    "vsdx:unpack": "node scripts/vsdx-serialize.mjs unpack",
    "vsdx:pack": "node scripts/vsdx-serialize.mjs pack",
    "vsdx:verify": "node scripts/vsdx-serialize.mjs verify",
    "test:vsdx-diff": "node scripts/test-vsdx-diff.mjs test-files/test4_connectors.vsdx test-files/test9_rect_and_line.vsdx",
    "test:diff-view": "node scripts/test-diff-view.mjs",
    "vsdx:install-difftool": "git config diff.vsdx.textconv 'node scripts/vsdx-serialize.mjs textconv' && git config diff.vsdx.binary true && git config merge.vsdx.name 'deterministic vsdx 3-way merge' && git config merge.vsdx.driver 'node scripts/vsdx-serialize.mjs merge %O %A %B %P' && echo 'git vsdx diff + merge drivers configured'"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jsdom": "^29.0.2"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.9",
    "cfb": "^1.2.2",
    "jszip": "^3.10.1"
  }
}
