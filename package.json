{
  "name": "vsdxeditor",
  "version": "0.0.2",
  "description": "Browser-based viewer, editor, and visual differ for Visio .vsdx (and .vsd) drawings, with a deterministic git diff/merge toolchain for .vsdx files.",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --outfile=dist/main.js --format=iife --minify",
    "postbuild": "node scripts/build-docs.mjs && node -e \"require('fs').copyFileSync('src/index.html','dist/app.html')\"",
    "package:portable": "npm run build && npm run postbuild && node scripts/build-portable.mjs",
    "dev": "npm run postbuild && node scripts/dev-server.mjs",
    "test": "npm run test:vsdx-diff && npm run test:diff-view && npm run test:svg-roundtrip && npm run test:app-svg-roundtrip && npm run test:view-templates && npm run test:view-templates-app",
    "vsdx:unpack": "node scripts/vsdx-serialize.mjs unpack",
    "vsdx:pack": "node scripts/vsdx-serialize.mjs pack",
    "vsdx:verify": "node scripts/vsdx-serialize.mjs verify",
    "test:vsdx-diff": "node scripts/test-vsdx-diff.mjs test-files/test4_connectors.vsdx test-files/test9_rect_and_line.vsdx",
    "test:diff-view": "node scripts/test-diff-view.mjs",
    "test:svg-roundtrip": "node scripts/test-svg-roundtrip.mjs",
    "test:app-svg-roundtrip": "node scripts/test-app-svg-roundtrip.mjs",
    "test:view-templates": "node scripts/test-view-templates.mjs",
    "test:view-templates-app": "node scripts/test-view-templates-app.mjs",
    "vsdx:install-difftool": "node scripts/install-git-integration.mjs"
  },
  "keywords": [
    "visio",
    "vsdx",
    "vsd",
    "viewer",
    "editor",
    "diff",
    "svg",
    "git"
  ],
  "author": "Smart Nexia",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartnexiacloud-lgtm/vsdxeditor.git"
  },
  "homepage": "https://smartnexiacloud-lgtm.github.io/vsdxeditor/",
  "bugs": {
    "url": "https://github.com/smartnexiacloud-lgtm/vsdxeditor/issues"
  },
  "type": "commonjs",
  "devDependencies": {
    "esbuild": "^0.28.0",
    "jsdom": "^29.0.2",
    "marked": "^18.0.5"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.9",
    "cfb": "^1.2.2",
    "jszip": "^3.10.1"
  }
}
